#!/bin/bash
# screenpipe の古いデータを削除する
#
# screenpipe 本体には保持期間(retention)の設定が存在しないため、自前で掃除する。
# 対象は3種類:
#   動画  ~/.screenpipe/data/monitor_N_YYYY-MM-DD_HH-MM-SS.mp4
#   ログ  ~/.screenpipe/screenpipe.YYYY-MM-DD.log
#   DB行  ~/.screenpipe/db.sqlite の frames / ocr_text / video_chunks
#
# 削除は「動画 → ログ → DB」の順に行う。DB の DELETE は WAL を大量に書くため、
# 先にディスクを空けておかないと途中で失敗するため。

set -uo pipefail

SP_DIR="${SCREENPIPE_DIR:-$HOME/.screenpipe}"
DB="$SP_DIR/db.sqlite"
DATA_DIR="$SP_DIR/data"

KEEP_MONTHS=2      # 今月を含めて何ヶ月分の動画/DBを残すか
LOG_KEEP_DAYS=7    # ログを何日分残すか
BATCH=50000        # DB削除の1バッチあたりの frame_id 幅

EXECUTE=0
ASSUME_YES=0
VACUUM_ONLY=0
SKIP_DB=0

usage() {
  cat <<'HELP'
screenpipe-prune - screenpipeの古いデータを削除する

使い方:
  screenpipe-prune                    削除対象を表示するだけ（dry-run。既定）
  screenpipe-prune --execute          確認のうえ削除を実行
  screenpipe-prune --execute --yes    確認なしで削除（launchd等の自動実行用）
  screenpipe-prune --vacuum           DBを圧縮してファイルサイズを縮める
  screenpipe-prune --help             このヘルプ

削除するもの:
  1. 保持期間を過ぎた動画・DB行
  2. どの video_chunks からも参照されていない動画（録画されたがDB登録に失敗した
     もの。OCRテキストがないので検索にかからず、再生対象にもならない）
  3. 保持期間を過ぎたログ

オプション:
  --keep-months N     動画とDBを今月含めNヶ月分残す（既定: 2 = 今月と先月）
  --log-keep-days N   ログをN日分残す（既定: 7）
  --skip-db           動画とログのみ削除し、DBは触らない
  --execute           実際に削除する（付けない限り何も消さない）
  --yes               確認プロンプトを省略する
  --vacuum            削除はせずVACUUMのみ実行する

注意:
  --execute でDBを触る場合と --vacuum は、screenpipe を停止しておく必要がある。
  VACUUM は DB と同サイズの空き容量と、数十分の時間を要する。

なぜ単純な DELETE ではだめか:
  ocr_text_fts / frames_fts は fts5 の UNINDEXED カラムで frame_id を持つため、
  削除トリガー(DELETE FROM ocr_text_fts WHERE frame_id = ...)が1行ごとに
  FTS全体をフルスキャンする。数百万行の削除では事実上終わらない。
  このスクリプトは削除トリガーを一時的に外し、削除後にFTSを作り直す。
HELP
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --execute) EXECUTE=1 ;;
    --yes|-y) ASSUME_YES=1 ;;
    --vacuum) VACUUM_ONLY=1 ;;
    --skip-db) SKIP_DB=1 ;;
    --keep-months) KEEP_MONTHS="$2"; shift ;;
    --log-keep-days) LOG_KEEP_DAYS="$2"; shift ;;
    *) echo "不明なオプション: $1" >&2; echo "screenpipe-prune --help を参照" >&2; exit 1 ;;
  esac
  shift
done

command -v sqlite3 >/dev/null || { echo "エラー: sqlite3 が見つかりません" >&2; exit 1; }
[ -d "$SP_DIR" ] || { echo "エラー: $SP_DIR がありません" >&2; exit 1; }

# ---------- 共通ヘルパー ----------

# バイト数を人間が読める形にする
human() {
  awk -v b="$1" 'BEGIN{
    split("B KB MB GB TB", u, " "); i=1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    printf (i==1 ? "%d %s\n" : "%.1f %s\n"), b, u[i]
  }'
}

# screenpipe が起動中なら 0 を返す
screenpipe_running() {
  curl -s -m 2 -o /dev/null "http://localhost:3030/health" 2>/dev/null
}

confirm() {
  [ "$ASSUME_YES" = 1 ] && return 0
  printf '%s [y/N]: ' "$1"
  read -r ans
  case "$ans" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# ---------- VACUUM のみ ----------

if [ "$VACUUM_ONLY" = 1 ]; then
  if screenpipe_running; then
    echo "エラー: screenpipe が起動中です。VACUUM の前に停止してください。" >&2
    exit 1
  fi
  before=$(stat -f '%z' "$DB")
  avail=$(df -k "$SP_DIR" | awk 'NR==2{print $4 * 1024}')
  echo "DB サイズ: $(human "$before")"
  echo "空き容量  : $(human "$avail")"
  if [ "$avail" -lt "$before" ]; then
    echo "エラー: VACUUM には DB と同等以上の空き容量が必要です。" >&2
    exit 1
  fi
  confirm "VACUUM を実行しますか？（数十分かかります）" || { echo "中止しました"; exit 0; }

  # VACUUM はテーブルを作り直すため、CHECK 制約に sqlite-vec の関数
  # (vec_length 等) を使っているテーブルがあると "no such function" で失敗する。
  # 拡張は screenpipe バイナリに静的リンクされていて単体では入手できず、
  # macOS標準の sqlite3 は OMIT_LOAD_EXTENSION でビルドされていてロードもできない。
  # そこで writable_schema で CHECK を一時的に外し、VACUUM 後に元へ戻す。
  # （CHECK の有無は行の格納形式に影響しないので、この差し替えは安全）
  STRIP_SQL=$(mktemp "${TMPDIR:-/tmp}/sp-strip.XXXXXX") || exit 1
  RESTORE_SQL=$(mktemp "${TMPDIR:-/tmp}/sp-restore.XXXXXX") || exit 1
  ORIG_TXT=$(mktemp "${TMPDIR:-/tmp}/sp-orig.XXXXXX") || exit 1

  python3 - "$DB" "$STRIP_SQL" "$RESTORE_SQL" "$ORIG_TXT" <<'PY'
import re, sqlite3, sys

db, strip_path, restore_path, orig_path = sys.argv[1:5]
con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
rows = con.execute(
    "SELECT name, sql FROM sqlite_master WHERE type='table' AND sql LIKE '%vec\\_%' ESCAPE '\\'"
).fetchall()
con.close()


def strip_check(sql):
    """CHECK(...) 句を対応する括弧まで含めて取り除く"""
    out, i = sql, 0
    while True:
        m = re.compile(r"\bcheck\s*\(", re.I).search(out, i)
        if not m:
            return out
        depth, j = 1, m.end()
        while j < len(out) and depth:
            depth += (out[j] == "(") - (out[j] == ")")
            j += 1
        if depth:
            return out  # 括弧が閉じていない。触らない
        cut = out[:m.start()] + out[j:]
        # CHECK を消したことで生じる ",," や "( ," を整える
        cut = re.sub(r",\s*,", ",", cut)
        cut = re.sub(r"\(\s*,", "(", cut)
        cut = re.sub(r",\s*\)", ")", cut)
        out, i = cut, m.start()


def q(s):
    return "'" + s.replace("'", "''") + "'"


strip, restore, orig = [], [], []
for name, sql in rows:
    stripped = strip_check(sql)
    if stripped == sql or "vec_" in stripped:
        continue  # 外せていない。対象にしない
    strip.append(f"UPDATE sqlite_master SET sql={q(stripped)} WHERE name={q(name)};")
    restore.append(f"UPDATE sqlite_master SET sql={q(sql)} WHERE name={q(name)};")
    orig.append(f"{name}\t{sql!r}")

for path, body in ((strip_path, strip), (restore_path, restore)):
    with open(path, "w") as f:
        if body:
            f.write("PRAGMA writable_schema=ON;\n")
            f.write("\n".join(body) + "\n")
            f.write("PRAGMA writable_schema=OFF;\n")
with open(orig_path, "w") as f:
    f.write("\n".join(orig) + ("\n" if orig else ""))
PY

  NEED_STRIP=$([ -s "$STRIP_SQL" ] && echo 1 || echo 0)

  restore_schema() {
    [ "$NEED_STRIP" = 1 ] || return 0
    sqlite3 "$DB" ".read $RESTORE_SQL" 2>/dev/null
  }

  if [ "$NEED_STRIP" = 1 ]; then
    echo "sqlite-vec を使う CHECK 制約を一時的に退避します..."
    trap 'restore_schema; exit 1' INT TERM
    trap restore_schema EXIT
    sqlite3 "$DB" ".read $STRIP_SQL" || { echo "スキーマの退避に失敗しました" >&2; exit 1; }
  fi

  echo "VACUUM 実行中..."
  time sqlite3 "$DB" "VACUUM;" || { echo "VACUUM に失敗しました" >&2; exit 1; }

  if [ "$NEED_STRIP" = 1 ]; then
    echo "CHECK 制約を書き戻しています..."
    restore_schema || { echo "スキーマの復元に失敗しました" >&2; exit 1; }
    trap - EXIT INT TERM
    # 元のスキーマと一字一句同じに戻っているか確認する
    python3 - "$DB" "$ORIG_TXT" <<'PY' || { echo "警告: スキーマが元と一致しません" >&2; exit 1; }
import ast, sqlite3, sys
db, orig_path = sys.argv[1:3]
con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
want = dict(
    (line.split("\t", 1)[0], ast.literal_eval(line.split("\t", 1)[1]))
    for line in open(orig_path).read().splitlines() if line
)
for name, sql in want.items():
    got = con.execute("SELECT sql FROM sqlite_master WHERE name=?", (name,)).fetchone()
    if not got or got[0] != sql:
        print(f"不一致: {name}", file=sys.stderr)
        sys.exit(1)
con.close()
PY
    echo "スキーマ復元を確認しました"
  fi

  rm -f "$STRIP_SQL" "$RESTORE_SQL" "$ORIG_TXT"
  after=$(stat -f '%z' "$DB")
  echo "完了: $(human "$before") → $(human "$after")"
  exit 0
fi

# ---------- 保持期間から締切日を決める ----------

# 動画とDB: 今月含め KEEP_MONTHS ヶ月分を残す → 締切は (KEEP_MONTHS-1) ヶ月前の1日
# 月末日から -1m すると月を飛ばすことがあるので、先に日を1に固定してから引く
CUTOFF=$(date -v1d -v-$((KEEP_MONTHS - 1))m +%Y-%m-01)
LOG_CUTOFF=$(date -v-"${LOG_KEEP_DAYS}"d +%Y-%m-%d)

echo "screenpipe データ削除"
echo "  対象ディレクトリ: $SP_DIR"
echo "  動画/DB: $CUTOFF より前を削除（今月含め ${KEEP_MONTHS}ヶ月分を保持）"
echo "  ログ    : $LOG_CUTOFF より前を削除（${LOG_KEEP_DAYS}日分を保持）"
echo ""

# ---------- 集計 ----------

# ファイル名 monitor_N_YYYY-MM-DD_HH-MM-SS.mp4 の日付部分で判定する。
# screenpipe はファイル名にも DB にも UTC を使うので、両者の境界は一致する。
old_videos() {
  [ -d "$DATA_DIR" ] || return 0
  # shellcheck disable=SC2010  # ファイル名は monitor_N_YYYY-MM-DD_... に限られる
  ls "$DATA_DIR" 2>/dev/null \
    | grep -E '^monitor_[0-9]+_[0-9]{4}-[0-9]{2}-[0-9]{2}_' \
    | awk -F_ -v c="$CUTOFF" '$3 < c'
}

# screenpipe.YYYY-MM-DD.log の日付部分で判定する
old_logs() {
  # shellcheck disable=SC2010  # ファイル名は screenpipe.YYYY-MM-DD.log に限られる
  ls "$SP_DIR" 2>/dev/null \
    | grep -E '^screenpipe\.[0-9]{4}-[0-9]{2}-[0-9]{2}\.log$' \
    | awk -F. -v c="$LOG_CUTOFF" '$2 < c'
}

# どの video_chunks からも参照されていない mp4。録画はされたが DB 登録に失敗した
# ファイルで、OCRテキストがないため検索にもかからず、再生対象にもならない。
# 書き込み途中のファイルを巻き込まないよう、更新から60分以上経ったものだけを見る。
orphan_videos() {
  [ -d "$DATA_DIR" ] && [ -f "$DB" ] || return 0
  local db_side disk_side
  db_side=$(mktemp "${TMPDIR:-/tmp}/sp-prune-db.XXXXXX") || return 0
  disk_side=$(mktemp "${TMPDIR:-/tmp}/sp-prune-disk.XXXXXX") || { rm -f "$db_side"; return 0; }
  sqlite3 "file:${DB}?mode=ro" "SELECT file_path FROM video_chunks;" 2>/dev/null \
    | sed 's|.*/||' | sort > "$db_side"
  find "$DATA_DIR" -maxdepth 1 -type f -name '*.mp4' -mmin +60 2>/dev/null \
    | sed 's|.*/||' | sort > "$disk_side"
  comm -23 "$disk_side" "$db_side"
  rm -f "$db_side" "$disk_side"
}

sum_size() {
  local dir="$1"
  awk -v d="$dir" '{print d "/" $0}' | tr '\n' '\0' \
    | xargs -0 stat -f '%z' 2>/dev/null \
    | awk '{t+=$1} END{print t+0}'
}

VIDEO_LIST=$(old_videos)
LOG_LIST=$(old_logs)
# 期限切れとして消す分は除く（二重計上と二重削除を避ける）。
# old_videos は ls 由来、orphan_videos は comm 由来でどちらもソート済み
ORPHAN_LIST=$(comm -23 <(orphan_videos) <(printf '%s\n' "$VIDEO_LIST"))

VIDEO_N=$(printf '%s' "$VIDEO_LIST" | grep -c . || true)
LOG_N=$(printf '%s' "$LOG_LIST" | grep -c . || true)
ORPHAN_N=$(printf '%s' "$ORPHAN_LIST" | grep -c . || true)
VIDEO_SIZE=$([ "$VIDEO_N" -gt 0 ] && printf '%s\n' "$VIDEO_LIST" | sum_size "$DATA_DIR" || echo 0)
LOG_SIZE=$([ "$LOG_N" -gt 0 ] && printf '%s\n' "$LOG_LIST" | sum_size "$SP_DIR" || echo 0)
ORPHAN_SIZE=$([ "$ORPHAN_N" -gt 0 ] && printf '%s\n' "$ORPHAN_LIST" | sum_size "$DATA_DIR" || echo 0)

echo "動画(期限切れ): ${VIDEO_N} 件  $(human "$VIDEO_SIZE")"
echo "動画(DB未登録): ${ORPHAN_N} 件  $(human "$ORPHAN_SIZE")"
echo "ログ          : ${LOG_N} 件  $(human "$LOG_SIZE")"

# DB は frames.id が timestamp と単調に対応するので、境界 id を1回引けば
# 以降は id 範囲で高速に消せる（timestamp 比較を毎回やるより速い）
BOUNDARY=""
FRAMES_OLD=0
if [ "$SKIP_DB" = 0 ] && [ -f "$DB" ]; then
  BOUNDARY=$(sqlite3 "file:${DB}?mode=ro" \
    "SELECT COALESCE(MAX(id), 0) FROM frames WHERE timestamp < '$CUTOFF';" 2>/dev/null)
  if [ -n "$BOUNDARY" ] && [ "$BOUNDARY" -gt 0 ] 2>/dev/null; then
    FRAMES_OLD=$(sqlite3 "file:${DB}?mode=ro" \
      "SELECT COUNT(*) FROM frames WHERE id <= $BOUNDARY;" 2>/dev/null)
    FRAMES_ALL=$(sqlite3 "file:${DB}?mode=ro" "SELECT COUNT(*) FROM frames;" 2>/dev/null)
    echo "DB  : frames ${FRAMES_OLD} / ${FRAMES_ALL} 行（frame_id <= ${BOUNDARY}）"
    echo "      DB ファイル $(human "$(stat -f '%z' "$DB")")（削除後の圧縮は --vacuum）"
  else
    echo "DB  : 削除対象なし"
    BOUNDARY=""
  fi
fi

TOTAL=$((VIDEO_SIZE + ORPHAN_SIZE + LOG_SIZE))
echo ""
echo "ファイル削除で空く容量: $(human "$TOTAL")"

if [ "$VIDEO_N" = 0 ] && [ "$ORPHAN_N" = 0 ] && [ "$LOG_N" = 0 ] && [ -z "$BOUNDARY" ]; then
  echo "削除するものはありません"
  exit 0
fi

if [ "$EXECUTE" = 0 ]; then
  echo ""
  echo "（dry-run。実際に削除するには --execute を付けてください）"
  exit 0
fi

# DB を触るには screenpipe が止まっている必要があるが、ファイルの削除は
# 起動中でも安全にできる。全部やめてしまうと geppou からの呼び出しや
# 定期実行で毎回失敗するので、DBフェーズだけ飛ばして続行する。
DB_SKIPPED=0
if [ -n "$BOUNDARY" ] && screenpipe_running; then
  echo ""
  echo "注意: screenpipe が起動中のため、DB の削除は飛ばします（ファイルのみ削除）。"
  BOUNDARY=""
  DB_SKIPPED=1
fi

echo ""
confirm "上記を削除しますか？" || { echo "中止しました"; exit 0; }

# ---------- 1. 動画 ----------

if [ "$VIDEO_N" -gt 0 ]; then
  echo ""
  echo "[1/3] 期限切れの動画を削除中 (${VIDEO_N} 件)..."
  printf '%s\n' "$VIDEO_LIST" | awk -v d="$DATA_DIR" '{print d "/" $0}' \
    | tr '\n' '\0' | xargs -0 -n 500 rm -f
  echo "      完了"
fi

if [ "$ORPHAN_N" -gt 0 ]; then
  echo "      DB未登録の動画を削除中 (${ORPHAN_N} 件)..."
  printf '%s\n' "$ORPHAN_LIST" | awk -v d="$DATA_DIR" '{print d "/" $0}' \
    | tr '\n' '\0' | xargs -0 -n 500 rm -f
  echo "      完了"
fi

# ---------- 2. ログ ----------

if [ "$LOG_N" -gt 0 ]; then
  echo "[2/3] ログを削除中 (${LOG_N} 件)..."
  printf '%s\n' "$LOG_LIST" | awk -v d="$SP_DIR" '{print d "/" $0}' \
    | tr '\n' '\0' | xargs -0 rm -f
  echo "      完了"
fi

# ---------- 3. DB ----------

if [ -z "$BOUNDARY" ]; then
  echo ""
  echo "完了。"
  if [ "$DB_SKIPPED" = 1 ]; then
    echo ""
    echo "DB の古い行は残っています。掃除するには screenpipe を止めてから:"
    echo "  launchctl bootout gui/\$(id -u)/com.screenpipe.agent"
    echo "  screenpipe-prune --execute && screenpipe-prune --vacuum"
    echo "  launchctl bootstrap gui/\$(id -u) ~/Library/LaunchAgents/com.screenpipe.agent.plist"
  fi
  exit 0
fi

echo "[3/3] DB の古い行を削除中..."

sq() { sqlite3 "$DB" "$@"; }

# 削除トリガーを外す。外したまま終了するとFTSが壊れたままになるので、
# どう終わっても必ず作り直す
restore_triggers() {
  sq "
CREATE TRIGGER IF NOT EXISTS ocr_text_delete AFTER DELETE ON ocr_text
BEGIN
    DELETE FROM ocr_text_fts WHERE frame_id = OLD.frame_id;
END;
CREATE TRIGGER IF NOT EXISTS frames_ad AFTER DELETE ON frames
BEGIN
    DELETE FROM frames_fts WHERE id = OLD.id;
END;
" 2>/dev/null
}
trap 'restore_triggers; exit 1' INT TERM
trap restore_triggers EXIT

sq "DROP TRIGGER IF EXISTS ocr_text_delete; DROP TRIGGER IF EXISTS frames_ad;" \
  || { echo "トリガーの削除に失敗しました" >&2; exit 1; }

# frame_id の範囲を区切って消す。一括だと WAL が DB と同サイズまで膨らむため
lo=0
while [ "$lo" -lt "$BOUNDARY" ]; do
  hi=$((lo + BATCH))
  [ "$hi" -gt "$BOUNDARY" ] && hi=$BOUNDARY
  sq "
DELETE FROM ocr_text WHERE frame_id > $lo AND frame_id <= $hi;
DELETE FROM frames   WHERE id       > $lo AND id       <= $hi;
" || { echo "DB削除に失敗しました (frame_id ${lo}-${hi})" >&2; exit 1; }
  sq "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null
  printf '\r      frames %d / %d (%d%%)' "$hi" "$BOUNDARY" $((hi * 100 / BOUNDARY))
  lo=$hi
done
echo ""

# どの frames からも参照されなくなった video_chunks を消す
echo "      video_chunks の孤児を削除中..."
sq "DELETE FROM video_chunks
    WHERE NOT EXISTS (SELECT 1 FROM frames WHERE frames.video_chunk_id = video_chunks.id);"

# FTS を作り直す。残った行だけを入れ直すほうが、1行ずつ消すより桁違いに速い
echo "      全文検索インデックスを再構築中..."
sq "
DROP TABLE IF EXISTS ocr_text_fts;
CREATE VIRTUAL TABLE ocr_text_fts USING fts5(
    text,
    app_name,
    window_name,
    frame_id UNINDEXED,
    tokenize='unicode61'
);
INSERT INTO ocr_text_fts(frame_id, text, app_name, window_name)
SELECT frame_id, text, COALESCE(app_name, ''), COALESCE(window_name, '')
FROM ocr_text
WHERE text IS NOT NULL AND text != '' AND frame_id IS NOT NULL;

DROP TABLE IF EXISTS frames_fts;
CREATE VIRTUAL TABLE frames_fts USING fts5(
    name,
    browser_url,
    app_name,
    window_name,
    focused,
    id UNINDEXED,
    tokenize='unicode61'
);
INSERT INTO frames_fts(id, name, browser_url, app_name, window_name, focused)
SELECT id, COALESCE(name, ''), COALESCE(browser_url, ''), COALESCE(app_name, ''),
       COALESCE(window_name, ''), COALESCE(focused, 0)
FROM frames;
" || { echo "FTSの再構築に失敗しました" >&2; exit 1; }

restore_triggers
trap - EXIT INT TERM

sq "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null

echo ""
echo "完了。"
echo "DB ファイルは $(human "$(stat -f '%z' "$DB")") のままです（空きページが再利用されます）。"
echo "ファイルサイズを実際に縮めるには: screenpipe-prune --vacuum"
